{
  "name": "ods-tracker-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "node --test test/",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply ods-tracker --local",
    "db:migrate:remote": "wrangler d1 migrations apply ods-tracker --remote",
    "backfill": "node --max-old-space-size=16000 scripts/backfill.ts",
    "trud:download": "node scripts/trud-download.ts",
    "spot-check": "node scripts/spot-check.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "fflate": "^0.8.2",
    "typescript": "^5.9",
    "wrangler": "^4.131.2"
  }
}
