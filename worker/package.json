{
  "name": "ods-tracker-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy && node scripts/revalidate-site.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "node --test test/*.test.ts",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply ods-tracker --local",
    "db:migrate:remote": "wrangler d1 migrations apply ods-tracker --remote",
    "backfill": "node --env-file=.env --max-old-space-size=16000 scripts/backfill.ts --trud",
    "import": "node scripts/import.ts",
    "trud:download": "node --env-file=.env scripts/trud-download.ts",
    "spot-check": "node scripts/spot-check.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "fflate": "^0.8.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.2"
  }
}
