{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ods-tracker-api",
  "main": "src/index.ts",
  "account_id": "e7ffabec5d1df79297886025881e4a03",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // ODS publishes changes daily at most; poll the ORD sync endpoint every 6 hours.
  "triggers": { "crons": ["17 */6 * * *"] },
  // Sync runs fetch hundreds of org records; allow up to 5 min CPU.
  "limits": { "cpu_ms": 300000 },
  "vars": {
    "ORD_BASE": "https://directory.spineservices.nhs.uk/ORD/2-0-0",
    // UI base URL, used for links in the RSS feed.
    "APP_URL": "https://ods-tracker-omega.vercel.app"
  },
  // Response cache for heavy, slow-changing reads (as-at lists, exports, activity).
  "kv_namespaces": [{ "binding": "CACHE", "id": "43a50d59eab24f17823bae3e31f54dc5" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ods-tracker",
      "database_id": "bf8cf70a-8798-46a2-85f4-1468dcd6d6df",
      "migrations_dir": "./migrations"
    }
  ]
}
